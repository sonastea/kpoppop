{
  "name": "kpoppop_backend",
  "private": true,
  "version": "1.8.0",
  "description": "Kpoppop Server Backend",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_ENV=development PORT=5000 nest start",
    "start:dev": "NODE_ENV=development PORT=5000 nest start --watch",
    "start:debug": "NODE_ENV=development PORT=5000 nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:migrate:prod": "prisma generate && prisma migrate deploy && npm run build && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "start:docker": "npm run prisma:generate && npm run prisma:migrate && npm run start:dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "watch-prisma": "nodemon --watch prisma/schema.prisma --exec prisma generate"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/cli": "^12.0.5",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/client": "^6.19.3",
    "@quixo3/prisma-session-store": "^3.1.19",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.4",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.4.0",
    "formidable": "^3.5.4",
    "ioredis": "^6.0.0",
    "joi": "^18.2.1",
    "necord": "^7.0.0",
    "pg-listen": "^1.7.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/passport": "^12.0.0",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "passport": "^0.5.3",
    "passport-discord-auth": "^1.2.0",
    "passport-local": "^1.0.0",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "passport": "^0.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "bcrypt@6.0.0": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "necord@7.0.0": true
  }
}
